<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up the learning database and settings to the user's Google account
     and include them in device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
