<?xml version="1.0" encoding="utf-8"?>

<android.support.constraint.ConstraintLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    android:layout_width="wrap_content"
    android:background="@drawable/border"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/word_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="50dp"
        android:text="Word :"
        android:textSize="16sp"
        android:fontFamily="@font/droidsans_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/meaning_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="16dp"
        android:text="Meaning :"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Word_txt"
        android:fontFamily="@font/droidsans_bold"/>

    <TextView
        android:id="@+id/synonyms_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:text="Synonyms :"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Meaning_txt"
        android:fontFamily="@font/droidsans_bold"/>

    <TextView
        android:id="@+id/Word_txt"
        android:layout_width="271dp"
        android:layout_height="41dp"
        android:layout_marginStart="92dp"
        android:layout_marginTop="8dp"
        android:text="Word_txt"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/word_lbl"
        android:fontFamily="@font/droidsans"/>

    <TextView
        android:id="@+id/Meaning_txt"
        android:layout_width="266dp"
        android:layout_height="77dp"
        android:layout_marginStart="92dp"
        android:layout_marginTop="20dp"
        android:text="Meaning_txt"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/meaning_lbl"
        android:fontFamily="@font/droidsans"/>

    <TextView
        android:id="@+id/Synonyms_txt"
        android:layout_width="268dp"
        android:layout_height="169dp"
        android:layout_marginStart="92dp"
        android:layout_marginTop="23dp"
        android:text="Synonyms_txt"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/synonyms_lbl"
        android:fontFamily="@font/droidsans"/>

</android.support.constraint.ConstraintLayout>